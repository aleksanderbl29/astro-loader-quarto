{
  "name": "astro-loader-quarto",
  "version": "1.0.0",
  "description": "Astro Loader for Quarto content collections with full type safety and field mapping",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "keywords": [
    "astro",
    "quarto",
    "content-collections",
    "loader",
    "astro-loader",
    "scientific-publishing",
    "academic"
  ],
  "author": "Aleksander",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleksanderbl29/astro-loader-quarto.git"
  },
  "homepage": "https://github.com/aleksanderbl29/astro-loader-quarto#readme",
  "bugs": {
    "url": "https://github.com/aleksanderbl29/astro-loader-quarto/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "commitlint": "commitlint --edit",
    "release": "semantic-release",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "astro": "^7.2.8"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^20.19.43",
    "astro": "^7.4.1",
    "eslint": "^9.39.5",
    "prettier": "3.6.2",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

{
  "name": "astro-loader-quarto",
  "version": "1.0.0",
  "description": "Astro Loader for Quarto content collections with full type safety and field mapping",
  "type": "module",
  "keywords": [
    "astro",
    "quarto",
    "content-collections",
    "loader",
    "astro-loader",
    "scientific-publishing",
    "academic"
  ],
  "author": "Aleksander",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleksanderbl29/astro-loader-quarto.git"
  },
  "homepage": "https://github.com/aleksanderbl29/astro-loader-quarto#readme",
  "bugs": {
    "url": "https://github.com/aleksanderbl29/astro-loader-quarto/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "pretest": "pnpm run build",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "commitlint": "commitlint --edit",
    "release": "semantic-release",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "yaml": "^2.3.4",
    "zod": "^4.3.6",
    "parse5": "^7.3.0",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-stringify": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@types/node": "^22.0.0",
    "astro": "6.0.4",
    "@astrojs/mdx": "5.0.0",
    "eslint": "^9.0.0",
    "prettier": "3.6.2",
    "semantic-release": "^25.0.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
